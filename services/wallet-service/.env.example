NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50053

# Usuario wallet_svc creado con `npm run roles` en artauction_bd. Solo ve el esquema wallet.
DATABASE_URL=postgresql://wallet_svc:replace-me@localhost:5433/artauction?schema=wallet

# Clave publica de identity-service (node scripts/generate-keys.mjs).
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

# Token de servicio (client credentials). El secreto esta en secrets/service-clients.env.
IDENTITY_GRPC_URL=127.0.0.1:50051
SERVICE_CLIENT_ID=wallet-service
SERVICE_CLIENT_SECRET=replace-me

# auction-service, para verificar pujas antes de liberar reservas vencidas.
AUCTION_GRPC_URL=127.0.0.1:50054

# Comision de la plataforma por venta en puntos basicos (1000 = 10 %).
PLATFORM_FEE_BPS=1000

RESERVATION_SWEEP_MS=30000
RESERVATION_SWEEP_ENABLED=true

GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
