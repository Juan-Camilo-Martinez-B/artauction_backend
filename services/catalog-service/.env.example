NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# Usuario catalog_svc creado con `npm run roles` en artauction_bd. Solo ve el esquema catalog.
DATABASE_URL=postgresql://catalog_svc:replace-me@localhost:5433/artauction?schema=catalog

# Clave publica de identity-service (node scripts/generate-keys.mjs).
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

# Token de servicio (client credentials). El secreto esta en secrets/service-clients.env.
IDENTITY_GRPC_URL=127.0.0.1:50051
SERVICE_CLIENT_ID=catalog-service
SERVICE_CLIENT_SECRET=replace-me

# Consumidores de los eventos del catalogo. Mientras gallery, audit y auction no
# existan como servicios, apuntan al servidor gRPC legado del monolito (LEGACY_GRPC_PORT).
GALLERY_EVENTS_GRPC_URL=127.0.0.1:50090
AUDIT_EVENTS_GRPC_URL=127.0.0.1:50090
AUCTION_EVENTS_GRPC_URL=127.0.0.1:50090

# Almacenamiento S3 (Garage en local). Credenciales en secrets/storage.env tras
# `bash scripts/storage/init-garage.sh`.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=artauction-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_UPLOAD_TTL_SECONDS=900
MEDIA_PUBLIC_BASE_URL=http://artauction-media.web.garage.localhost:3902

# 0 = vCPU - 1 hilos para el hash perceptual.
IMAGE_HASH_WORKERS=0
OUTBOX_RELAY_ENABLED=true

GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
