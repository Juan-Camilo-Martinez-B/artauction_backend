NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50056

# Usuario audit_svc creado con `npm run roles` en artauction_bd. Solo ve el esquema audit, donde
# tambien viven los informes completos (audit.reports).
DATABASE_URL=postgresql://audit_svc:replace-me@localhost:5433/artauction?schema=audit

# Clave publica de identity-service (node scripts/generate-keys.mjs).
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

# Token de servicio (client credentials). El secreto esta en secrets/service-clients.env.
IDENTITY_GRPC_URL=127.0.0.1:50051
SERVICE_CLIENT_ID=audit-service
SERVICE_CLIENT_SECRET=replace-me

# Ficha de la obra y duplicados (catalog) y evaluacion del expediente (ai).
CATALOG_GRPC_URL=127.0.0.1:50052
AI_GRPC_URL=127.0.0.1:50055

# Consumidores de AuditCompleted: programacion de la sala y aviso al vendedor.
AUCTION_EVENTS_GRPC_URL=127.0.0.1:50054
NOTIFICATION_EVENTS_GRPC_URL=127.0.0.1:50058

# Imagenes: solo se descargan de la base publica de Garage (pedida a su
# direccion interna) y de los hosts https listados. Con tope de tamano y tiempo.
MEDIA_PUBLIC_BASE_URL=http://artauction-media.web.garage.localhost:3902
MEDIA_INTERNAL_BASE_URL=http://127.0.0.1:3902
AUDIT_IMAGE_HOSTS=images.metmuseum.org
IMAGE_FETCH_TIMEOUT_MS=8000
IMAGE_MAX_BYTES=12000000

WORKER_INTERVAL_MS=3000
WORKER_ENABLED=true
OUTBOX_RELAY_ENABLED=true

GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
