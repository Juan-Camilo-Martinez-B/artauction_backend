{
  "name": "@artauction/api-gateway",
  "private": true,
  "version": "0.1.0",
  "description": "BFF de ArtAuction AI: contrato REST y Socket.IO del frontend sobre los microservicios gRPC.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
