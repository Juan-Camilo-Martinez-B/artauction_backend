NODE_ENV=development
# El frontend sigue apuntando a este puerto.
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Monolito que atiende las rutas aun no migradas. Vacio desactiva el proxy.
LEGACY_URL=http://127.0.0.1:3002

IDENTITY_GRPC_URL=127.0.0.1:50051
CATALOG_GRPC_URL=127.0.0.1:50052
AUCTION_GRPC_URL=127.0.0.1:50054
# Mientras audit no exista como servicio, el monolito lo atiende (LEGACY_GRPC_PORT).
AUDIT_GRPC_URL=127.0.0.1:50090

# Clave publica de identity-service: autentica los sockets de la sala en vivo.
# Vacia, la sala en vivo queda desactivada.
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem
GRPC_DEADLINE_MS=5000

# TLS de gRPC hacia los servicios. En local va desactivado.
GRPC_TLS=false
GRPC_TLS_CA=
GRPC_TLS_CERT=
GRPC_TLS_KEY=
