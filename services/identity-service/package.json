{
  "name": "@artauction/identity-service",
  "private": true,
  "version": "0.1.0",
  "description": "Cuentas, sesiones y emision de tokens RS256 de ArtAuction AI.",
  "main": "dist/main.js",
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "build": "npm run generate && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "typecheck": "npm run generate && tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run generate && jest"
  },
  "dependencies": {
    "@artauction/contracts": "1.0.0",
    "@artauction/platform": "0.1.0",
    "@artauction/service-kit": "0.1.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "^8.24.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
