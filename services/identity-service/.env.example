NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Usuario identity_svc creado con `npm run roles` en artauction_bd. Solo ve el esquema identity.
DATABASE_URL=postgresql://identity_svc:replace-me@localhost:5433/artauction?schema=identity

# Claves generadas con `node scripts/generate-keys.mjs` en la raiz del monorepo.
JWT_PRIVATE_KEY_PATH=../../secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SERVICE_TOKEN_TTL=5m

# Huellas client-id:sha256 de secrets/service-clients.env.
SERVICE_CLIENTS=

# Barrido de sesiones de refresh vencidas (cada hora).
SESSION_SWEEP_MS=3600000
SESSION_SWEEP_ENABLED=true

# TLS de gRPC. En local va desactivado.
GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
