NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50054

# Usuario auction_svc creado con `npm run roles` en artauction_bd. Solo ve el esquema auction.
DATABASE_URL=postgresql://auction_svc:replace-me@localhost:5433/artauction?schema=auction

# Clave publica de identity-service (node scripts/generate-keys.mjs).
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

# Token de servicio (client credentials). El secreto esta en secrets/service-clients.env.
IDENTITY_GRPC_URL=127.0.0.1:50051
SERVICE_CLIENT_ID=auction-service
SERVICE_CLIENT_SECRET=replace-me

# Ficha de la obra (catalog) y reservas TCC de las pujas (wallet).
CATALOG_GRPC_URL=127.0.0.1:50052
WALLET_GRPC_URL=127.0.0.1:50053

# Consumidores de AuctionClosed: galeria del ganador y avisos.
GALLERY_EVENTS_GRPC_URL=127.0.0.1:50057
NOTIFICATION_EVENTS_GRPC_URL=127.0.0.1:50058

# Apertura y cierre de salas. Debe correr en una sola instancia (ver README).
SCHEDULER_INTERVAL_MS=5000
SCHEDULER_ENABLED=true
OUTBOX_RELAY_ENABLED=true

# Subastas rotativas: mantiene AUTO_AUCTION_SLOTS salas activas o por abrir sobre
# obras publicadas sin subasta. Cada sala abre entre 1 minuto y
# AUTO_AUCTION_MAX_LEAD_SECONDS despues y dura entre MIN y MAX minutos. La salida
# es el punto medio de la auditoria por AUTO_AUCTION_PRICE_FACTOR.
AUTO_AUCTION_ENABLED=true
AUTO_AUCTION_SLOTS=3
AUTO_AUCTION_MIN_MINUTES=15
AUTO_AUCTION_MAX_MINUTES=30
AUTO_AUCTION_MAX_LEAD_SECONDS=300
AUTO_AUCTION_PRICE_FACTOR=0.1

GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
