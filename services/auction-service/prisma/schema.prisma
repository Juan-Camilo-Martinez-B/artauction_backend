// Solo el esquema `auction`. La URL lleva ?schema=auction y el usuario
// auction_svc no tiene permisos sobre otros esquemas. El DDL vive en
// artauction_bd: este servicio no ejecuta migraciones.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auction {
  id              String   @id @default(uuid()) @db.Uuid
  lotId           String   @unique @map("lot_id") @db.Uuid
  sellerId        String?  @map("seller_id") @db.Uuid
  lotTitle        String?  @map("lot_title")
  startPrice      Decimal  @map("start_price") @db.Decimal(12, 2)
  currentPrice    Decimal  @map("current_price") @db.Decimal(12, 2)
  minIncrement    Decimal  @map("min_increment") @db.Decimal(12, 2)
  currency        String   @default("USD") @db.Char(3)
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(6)
  initialEndsAt   DateTime @map("initial_ends_at") @db.Timestamptz(6)
  status          String   @default("PROGRAMADA")
  winnerId        String?  @map("winner_id") @db.Uuid
  winningBidId    String?  @unique @map("winning_bid_id") @db.Uuid
  extensionCount  Int      @default(0) @map("extension_count")
  durationMinutes Int      @default(60) @map("duration_minutes")
  saleDescription String?  @map("sale_description")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bids Bid[] @relation("AuctionBids")

  @@map("auctions")
}

model Bid {
  id             String   @id @default(uuid()) @db.Uuid
  auctionId      String   @map("auction_id") @db.Uuid
  bidderId       String   @map("bidder_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  idempotencyKey String   @unique @map("idempotency_key")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  auction Auction @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Restrict)

  @@index([auctionId, createdAt(sort: Desc)], map: "bids_auction_id_created_at_idx")
  @@map("bids")
}

model Sale {
  id        String   @id @default(uuid()) @db.Uuid
  auctionId String   @unique @map("auction_id") @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @db.Char(3)
  status    String   @default("PENDIENTE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("transactions")
}
