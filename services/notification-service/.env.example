NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50058

# Usuario notification_svc creado con `npm run roles` en artauction_bd. Solo ve el
# esquema notification: los avisos y su inbox.
DATABASE_URL=postgresql://notification_svc:replace-me@localhost:5433/artauction?schema=notification

# Clave publica de identity-service: verifica usuarios y servicios que llaman.
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
