NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50057

# Usuario gallery_svc creado con `npm run roles` en artauction_bd. Solo ve el esquema gallery.
DATABASE_URL=postgresql://gallery_svc:replace-me@localhost:5433/artauction?schema=gallery

# Clave publica de identity-service (node scripts/generate-keys.mjs).
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

# Token de servicio (client credentials). El secreto esta en secrets/service-clients.env.
IDENTITY_GRPC_URL=127.0.0.1:50051
SERVICE_CLIENT_ID=gallery-service
SERVICE_CLIENT_SECRET=replace-me

# Fichas de obra (catalog) y diseno de la sala (ai-service; sin modelo se usa el diseno local).
CATALOG_GRPC_URL=127.0.0.1:50052
AI_GRPC_URL=127.0.0.1:50055

GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
