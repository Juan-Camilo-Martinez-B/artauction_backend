NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50055

# Clave publica de identity-service: verifica los tokens de servicio de quien llama.
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

# Unico servicio con la clave de Gemini. Vacia: la auditoria usa la evaluacion
# local determinista y DesignGallery responde FAILED_PRECONDITION.
GEMINI_API_KEY=
# Modelos 2.x apagan el razonamiento con thinkingBudget=0; 3.x en adelante usan thinkingLevel=minimal.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
