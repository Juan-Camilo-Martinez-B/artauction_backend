NODE_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50055

# Clave publica de identity-service: verifica los tokens de servicio de quien llama.
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

# Unico servicio con la clave de Groq (console.groq.com). Vacia: la auditoria usa
# la evaluacion local determinista y DesignGallery responde FAILED_PRECONDITION.
# Conviene activar Zero Data Retention en Data Controls de la consola de Groq.
GROQ_API_KEY=
# Debe admitir JSON en modo estricto: los gpt-oss (120b o 20b) lo hacen.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=15000

# Traduccion automatica de fichas con Opus-MT (local, sin clave ni cuota). La
# primera vez descarga los modelos (~230 MB) a TRANSLATION_CACHE_DIR.
TRANSLATION_ENABLED=true
TRANSLATION_CACHE_DIR=.cache/models
TRANSLATION_TIMEOUT_MS=180000

GRPC_TLS=false
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
