NODE_ENV=development
PORT=3001

# Postgres (Neon en producción). Cadena que consume Prisma.
DATABASE_URL=postgresql://artauction:artauction@localhost:5432/artauction?schema=public

# MongoDB (Atlas M0 en producción).
MONGODB_URI=mongodb://localhost:27017/artauction

# JWT. Generar cada secreto con: openssl rand -base64 48
# El access token es corto. El refresh rota en cada uso.
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me
JWT_REFRESH_TTL=7d

# Gemini. Vacío en local: el puerto AiAuditPort usa el adaptador fake.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# local firma URLs HMAC de desarrollo. gcs usa Cloud Storage cuando el bucket está configurado.
STORAGE_DRIVER=local

# Cloud Storage para imágenes de obras. Las URLs firmadas caducan.
GCS_BUCKET=artauction-images-dev
GCS_SIGNED_URL_TTL_SECONDS=900

# Orígenes permitidos del frontend. Lista separada por comas.
CORS_ORIGINS=http://localhost:3000

# Esquema de pg-boss dentro del mismo Postgres.
PGBOSS_SCHEMA=pgboss
