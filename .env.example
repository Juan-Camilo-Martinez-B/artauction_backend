NODE_ENV=development
PORT=3002

# Postgres (Neon en producción). Cadena que consume Prisma.
DATABASE_URL=postgresql://artauction:artauction@localhost:5432/artauction?schema=public

# MongoDB (Atlas M0 en producción).
MONGODB_URI=mongodb://localhost:27017/artauction

# JWT. Generar cada secreto con: openssl rand -base64 48
# El access token es corto. El refresh rota en cada uso.
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me
JWT_REFRESH_TTL=7d

# Migracion a microservicios: el monolito escucha en 3002 detras del api-gateway
# y acepta los access tokens RS256 de identity-service con esta clave publica.
JWT_PUBLIC_KEY_PATH=secrets/jwt/public.pem

# Servidor gRPC legado: atiende los eventos de gallery y notification mientras
# esos servicios no existen. 0 lo apaga.
LEGACY_GRPC_PORT=50090

# Con auction-service activo (F6) el monolito no abre ni cierra salas.
AUCTIONS_IN_SERVICE=true

# Transitorio hasta F8: el diseno de galerias se pide a ai-service, que es el
# unico con la clave de Gemini. El monolito se identifica como gallery-service
# (secreto en secrets/service-clients.env). Vacio usa el diseno local.
AI_GRPC_URL=127.0.0.1:50055
IDENTITY_GRPC_URL=127.0.0.1:50051
GALLERY_SERVICE_CLIENT_SECRET=


# local firma URLs HMAC de desarrollo. gcs usa Cloud Storage cuando el bucket está configurado.
STORAGE_DRIVER=local

# Cloud Storage para imágenes de obras. Las URLs firmadas caducan.
GCS_BUCKET=artauction-images-dev
GCS_SIGNED_URL_TTL_SECONDS=900

# Orígenes permitidos del frontend. Lista separada por comas.
CORS_ORIGINS=http://localhost:3000

# Esquema de pg-boss dentro del mismo Postgres.
PGBOSS_SCHEMA=pgboss
