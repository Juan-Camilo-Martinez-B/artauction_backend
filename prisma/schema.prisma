generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  passwordHash      String   @map("password_hash")
  displayName       String   @map("display_name")
  role              String   @default("USER")
  profileVisibility String   @default("PUBLIC") @map("profile_visibility")
  bio               String?
  avatarUrl         String?  @map("avatar_url")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lots Lot[]
  wonAuctions Auction[] @relation("AuctionWinner")
  bids Bid[]
  purchases Transaction[] @relation("TransactionBuyer")
  sales     Transaction[] @relation("TransactionSeller")
  following Follow[] @relation("Follows")
  followers Follow[] @relation("FollowedBy")
  personalGallery PersonalGallery?
  wallet Wallet?
  walletEntries WalletEntry[]
  bidHolds BidHold[]
  paymentOrders PaymentOrder[]

  @@map("users")
}
model Lot {
  id                String   @id @default(uuid()) @db.Uuid
  sellerId          String   @map("seller_id") @db.Uuid
  title             String
  description       String
  artistName        String?  @map("artist_name")
  creationYear      Int?     @map("creation_year")
  materials         String
  widthCm           Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm          Decimal? @map("height_cm") @db.Decimal(8, 2)
  depthCm           Decimal? @map("depth_cm") @db.Decimal(8, 2)
  provenance        String?
  representationKind String? @map("representation_kind")
  status            String   @default("BORRADOR")
  visibility        String   @default("PRIVATE")
  authenticityScore Int?     @map("authenticity_score") @db.SmallInt
  suggestedPriceMin Decimal? @map("suggested_price_min") @db.Decimal(12, 2)
  suggestedPriceMax Decimal? @map("suggested_price_max") @db.Decimal(12, 2)
  currency          String   @default("USD") @db.Char(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller User @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  images LotImage[]
  auction Auction?
  transactions Transaction[]
  auditSummaries AuditSummary[]
  categories LotCategory[]
  galleryPlacements PersonalGalleryArtwork[]


  @@index([sellerId], map: "lots_seller_id_idx")
  @@index([status], map: "lots_status_idx")

  @@map("lots")
}
model LotImage {
  id             String   @id @default(uuid()) @db.Uuid
  lotId          String   @map("lot_id") @db.Uuid
  objectKey      String   @map("object_key")
  position       Int
  perceptualHash String?  @map("perceptual_hash")
  widthPx        Int?     @map("width_px")
  heightPx       Int?     @map("height_px")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId], map: "lot_images_lot_id_idx")

  @@unique([lotId, position])
  @@map("lot_images")
}
