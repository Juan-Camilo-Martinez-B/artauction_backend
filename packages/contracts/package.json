{
  "name": "@artauction/contracts",
  "private": true,
  "version": "1.0.0",
  "description": "Contratos gRPC versionados de ArtAuction AI y el codigo TypeScript generado a partir de ellos.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint:proto": "buf lint",
    "breaking": "buf breaking --against \"../../.git#branch=main,subdir=packages/contracts\"",
    "generate": "buf generate --clean",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "typecheck": "npm run generate && tsc --noEmit -p tsconfig.json",
    "test": "npm run generate && jest"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "ts-proto": "^2.18.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.6"
  }
}
