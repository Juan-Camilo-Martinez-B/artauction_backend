{
  "name": "artauction-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo de los microservicios de ArtAuction AI: contratos gRPC, paquetes compartidos y servicios.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint --no-error-on-unmatched-pattern \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"services/*/src/**/*.ts\" \"services/*/test/**/*.ts\" \"e2e/**/*.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w @artauction/e2e",
    "compose:up": "docker compose --env-file secrets/service-clients.env --env-file secrets/compose.env up -d --build",
    "compose:down": "docker compose --env-file secrets/service-clients.env --env-file secrets/compose.env down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.45.1": true
  }
}
