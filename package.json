{
  "name": "artauction-backend",
  "private": true,
  "version": "0.1.0",
  "description": "API y tiempo real de ArtAuction AI.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
